[Unit]
Description=SGU ACW 题解生成（一次）
Documentation=https://github.com/hsn8086/sgu-acw-rank-backend
After=network-online.target sgu-acw-api.service
Wants=network-online.target
# 生成要调本机的后端接口。
Requires=sgu-acw-api.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sgu-acw-editorial
ExecStart=/opt/sgu-acw-editorial/run.sh
EnvironmentFile=/etc/sgu-acw-editorial.env

# 整个任务的上限。
#
# run.sh 是逐题跑的，单题 15 分钟（SGU_ACW_PER_PROBLEM_TIMEOUT），
# 当前四道题最坏 60 分钟。这里给 90 分钟留余量。
#
# 这个值只是兜底：单题的卡住由 run.sh 里的 timeout 处理，不会累积到这里。
# 之前设 45 分钟、一次跑完全部题，结果一道卡住整个任务被掐掉，
# 已经写完的也白写（2026-10-05、10-06 连续两天）。
TimeoutStartSec=5400

# 生成器需要写 node 的缓存目录，其余只读。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sgu-acw-editorial
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
